# Virtual environments
venv/
venv-gst/
.venv/
env/

# Python bytecode and build artifacts
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
build/
dist/
.eggs/

# TLS material. server.py regenerates a self-signed cert on first run.
certs/
*.key
*.pem
*.crt
*.cer
*.p12
*.pfx
*.jks

# Secrets and local config
.env
.env.*
*.secret
secrets.json
config.local.*

# Logs, captures, recordings, profiling output
*.log
logs/
server.log
*.mp4
*.mkv
*.h264
*.ivf
*.yuv
*.raw
*.wav
captures/
recordings/
*.prof
*.pstats

# Third-party redistributables that are downloaded, not authored here.
# GStreamer MSVC runtime installer and the VB-Cable driver package.
downloads/
tools/

# Generated by install-autostart.bat, contains absolute local paths
start-hidden.vbs

# Backups and scratch
backups/
*.bak
*.orig
*.tmp
*~

# Editor and OS noise
.vscode/
.idea/
*.swp
Thumbs.db
desktop.ini
Desktop.ini
